{
  "id": "brightline",
  "name": "Brightline",
  "pitch": "A calm, light dental clinic site: an arch-framed smile that opens as you scroll, floating trust badges, treatments you tap through with prices, a drag-to-compare result, a first-visit journey that lights up step by step, membership plans and a real booking flow with days and time slots.",
  "kind": "vite",
  "categories": [
    "Scroll",
    "Interactive",
    "Editorial"
  ],
  "business": [
    "dentist",
    "health",
    "hospital"
  ],
  "sector": "Family and cosmetic dental clinic",
  "intensity": 5,
  "heavy": false,
  "licence": {
    "kind": "original",
    "holder": "Site Builder",
    "note": "Made for the builder as an original template. Pictures are free AI generations (Pollinations) kept in source/public/media.",
    "added": "2026-11-18"
  },
  "remoteAssets": [],
  "features": [
    "Scroll-opening arch hero",
    "Treatment explorer",
    "Before and after slider",
    "Scroll-lit first-visit steps",
    "Membership plans",
    "Booking with days and time slots",
    "FAQ",
    "Hours and map link"
  ],
  "roles": {
    "mode": "light",
    "stage": "light",
    "colors": {
      "page": "page",
      "surface": "surface",
      "text": "ink",
      "muted": "muted",
      "accent": "accent",
      "accentSoft": "soft",
      "highlight": "fill2",
      "dark": "dark",
      "onAccent": "onAccent"
    },
    "fonts": {
      "display": "display",
      "body": "body"
    },
    "radius": "radius"
  },
  "schema": [
    {
      "group": "Business",
      "fields": [
        {
          "path": "brand.name",
          "label": "Business name",
          "type": "text",
          "hint": "Fills every {name} in the text below."
        },
        {
          "path": "brand.short",
          "label": "Short name (logo)",
          "type": "text"
        },
        {
          "path": "brand.phone",
          "label": "Phone",
          "type": "text"
        },
        {
          "path": "brand.email",
          "label": "Email",
          "type": "text"
        },
        {
          "path": "brand.address",
          "label": "Address",
          "type": "text"
        },
        {
          "path": "brand.mapLink",
          "label": "Map link",
          "type": "url"
        },
        {
          "path": "seo.title",
          "label": "Page title (search and browser tab)",
          "type": "text"
        },
        {
          "path": "seo.description",
          "label": "Short description (search and sharing)",
          "type": "textarea"
        }
      ]
    },
    {
      "group": "Sections",
      "fields": [
        {
          "path": "sections.stats",
          "label": "Show numbers",
          "type": "toggle"
        },
        {
          "path": "sections.treatments",
          "label": "Show treatments",
          "type": "toggle"
        },
        {
          "path": "sections.results",
          "label": "Show before and after",
          "type": "toggle"
        },
        {
          "path": "sections.journey",
          "label": "Show first-visit steps",
          "type": "toggle"
        },
        {
          "path": "sections.team",
          "label": "Show team",
          "type": "toggle"
        },
        {
          "path": "sections.plans",
          "label": "Show plans",
          "type": "toggle"
        },
        {
          "path": "sections.reviews",
          "label": "Show reviews",
          "type": "toggle"
        },
        {
          "path": "sections.faq",
          "label": "Show questions",
          "type": "toggle"
        },
        {
          "path": "sections.visit",
          "label": "Show hours and location",
          "type": "toggle"
        }
      ]
    },
    {
      "group": "Menu",
      "fields": [
        {
          "path": "nav.links",
          "label": "Menu links",
          "type": "list",
          "itemLabel": "Link",
          "fields": [
            {
              "path": "label",
              "label": "Label",
              "type": "text"
            },
            {
              "path": "href",
              "label": "Goes to",
              "type": "url"
            }
          ],
          "min": 0,
          "max": 8
        },
        {
          "path": "nav.cta",
          "label": "Booking button",
          "type": "text"
        }
      ]
    },
    {
      "group": "Opening",
      "fields": [
        {
          "path": "hero.kicker",
          "label": "Small line above",
          "type": "text"
        },
        {
          "path": "hero.title",
          "label": "Headline",
          "type": "textarea"
        },
        {
          "path": "hero.text",
          "label": "Intro",
          "type": "textarea"
        },
        {
          "path": "hero.primary",
          "label": "Main button",
          "type": "text"
        },
        {
          "path": "hero.secondary",
          "label": "Second button",
          "type": "text"
        },
        {
          "path": "hero.image",
          "label": "Picture",
          "type": "image"
        },
        {
          "path": "hero.imageAlt",
          "label": "Picture description",
          "type": "text"
        },
        {
          "path": "hero.badge1",
          "label": "Badge 1 (rating)",
          "type": "text"
        },
        {
          "path": "hero.badge2",
          "label": "Badge 2",
          "type": "text"
        },
        {
          "path": "hero.badge3",
          "label": "Badge 3",
          "type": "text"
        }
      ]
    },
    {
      "group": "Numbers",
      "fields": [
        {
          "path": "stats.items",
          "label": "Numbers",
          "type": "list",
          "itemLabel": "Number",
          "fields": [
            {
              "path": "value",
              "label": "Number",
              "type": "text",
              "hint": "Counts up, e.g. 4.9, 12,400+ or 98%"
            },
            {
              "path": "label",
              "label": "Label",
              "type": "text"
            }
          ],
          "min": 0,
          "max": 6
        }
      ]
    },
    {
      "group": "Treatments",
      "fields": [
        {
          "path": "treatments.kicker",
          "label": "Small heading",
          "type": "text"
        },
        {
          "path": "treatments.title",
          "label": "Heading",
          "type": "textarea"
        },
        {
          "path": "treatments.text",
          "label": "Intro",
          "type": "textarea"
        },
        {
          "path": "treatments.items",
          "label": "Treatments",
          "type": "list",
          "itemLabel": "Treatment",
          "fields": [
            {
              "path": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "path": "summary",
              "label": "One line",
              "type": "textarea"
            },
            {
              "path": "detail",
              "label": "What happens",
              "type": "textarea"
            },
            {
              "path": "price",
              "label": "Price",
              "type": "text"
            },
            {
              "path": "time",
              "label": "How long",
              "type": "text"
            },
            {
              "path": "image",
              "label": "Picture",
              "type": "image"
            }
          ],
          "min": 1,
          "max": 12
        }
      ]
    },
    {
      "group": "Before and after",
      "fields": [
        {
          "path": "results.kicker",
          "label": "Small heading",
          "type": "text"
        },
        {
          "path": "results.title",
          "label": "Heading",
          "type": "text"
        },
        {
          "path": "results.text",
          "label": "Note",
          "type": "textarea"
        },
        {
          "path": "results.before",
          "label": "Before picture",
          "type": "image"
        },
        {
          "path": "results.after",
          "label": "After picture",
          "type": "image"
        },
        {
          "path": "results.tintBefore",
          "label": "Tint the before picture",
          "type": "toggle",
          "hint": "Handy while you only have one picture."
        },
        {
          "path": "results.beforeLabel",
          "label": "Before label",
          "type": "text"
        },
        {
          "path": "results.afterLabel",
          "label": "After label",
          "type": "text"
        }
      ]
    },
    {
      "group": "First visit",
      "fields": [
        {
          "path": "journey.kicker",
          "label": "Small heading",
          "type": "text"
        },
        {
          "path": "journey.title",
          "label": "Heading",
          "type": "text"
        },
        {
          "path": "journey.steps",
          "label": "Steps",
          "type": "list",
          "itemLabel": "Step",
          "fields": [
            {
              "path": "title",
              "label": "Title",
              "type": "text"
            },
            {
              "path": "text",
              "label": "Text",
              "type": "textarea"
            }
          ],
          "min": 1,
          "max": 8
        }
      ]
    },
    {
      "group": "Team",
      "fields": [
        {
          "path": "team.kicker",
          "label": "Small heading",
          "type": "text"
        },
        {
          "path": "team.title",
          "label": "Heading",
          "type": "text"
        },
        {
          "path": "team.members",
          "label": "People",
          "type": "list",
          "itemLabel": "Person",
          "fields": [
            {
              "path": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "path": "role",
              "label": "Role",
              "type": "text"
            },
            {
              "path": "bio",
              "label": "Short bio",
              "type": "textarea"
            },
            {
              "path": "image",
              "label": "Photo",
              "type": "image"
            }
          ],
          "min": 0,
          "max": 12
        }
      ]
    },
    {
      "group": "Plans",
      "fields": [
        {
          "path": "plans.kicker",
          "label": "Small heading",
          "type": "text"
        },
        {
          "path": "plans.title",
          "label": "Heading",
          "type": "text"
        },
        {
          "path": "plans.text",
          "label": "Intro",
          "type": "textarea"
        },
        {
          "path": "plans.items",
          "label": "Plans",
          "type": "list",
          "itemLabel": "Plan",
          "fields": [
            {
              "path": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "path": "price",
              "label": "Price",
              "type": "text"
            },
            {
              "path": "period",
              "label": "Per",
              "type": "text"
            },
            {
              "path": "features",
              "label": "What's included (one per line)",
              "type": "textarea"
            },
            {
              "path": "highlight",
              "label": "Highlight this plan",
              "type": "toggle"
            },
            {
              "path": "button",
              "label": "Button",
              "type": "text"
            }
          ],
          "min": 0,
          "max": 4
        }
      ]
    },
    {
      "group": "Reviews",
      "fields": [
        {
          "path": "reviews.kicker",
          "label": "Small heading",
          "type": "text"
        },
        {
          "path": "reviews.items",
          "label": "Reviews",
          "type": "list",
          "itemLabel": "Review",
          "fields": [
            {
              "path": "quote",
              "label": "Quote",
              "type": "textarea"
            },
            {
              "path": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "path": "detail",
              "label": "Treatment",
              "type": "text"
            }
          ],
          "min": 0,
          "max": 12
        },
        {
          "path": "reviews.autoplay",
          "label": "Move on by itself",
          "type": "toggle"
        }
      ]
    },
    {
      "group": "Questions",
      "fields": [
        {
          "path": "faq.kicker",
          "label": "Small heading",
          "type": "text"
        },
        {
          "path": "faq.title",
          "label": "Heading",
          "type": "text"
        },
        {
          "path": "faq.items",
          "label": "Questions",
          "type": "list",
          "itemLabel": "Question",
          "fields": [
            {
              "path": "q",
              "label": "Question",
              "type": "text"
            },
            {
              "path": "a",
              "label": "Answer",
              "type": "textarea"
            }
          ],
          "min": 0,
          "max": 16
        }
      ]
    },
    {
      "group": "Hours and location",
      "fields": [
        {
          "path": "visit.kicker",
          "label": "Small heading",
          "type": "text"
        },
        {
          "path": "visit.title",
          "label": "Heading",
          "type": "text"
        },
        {
          "path": "visit.hours",
          "label": "Opening hours (Day | Hours, one per line)",
          "type": "textarea"
        },
        {
          "path": "visit.note",
          "label": "Parking and access",
          "type": "textarea"
        },
        {
          "path": "visit.emergency",
          "label": "Emergency line (leave empty to hide)",
          "type": "textarea"
        },
        {
          "path": "visit.image",
          "label": "Picture",
          "type": "image"
        }
      ]
    },
    {
      "group": "Booking",
      "fields": [
        {
          "path": "booking.title",
          "label": "Heading",
          "type": "text"
        },
        {
          "path": "booking.text",
          "label": "Intro",
          "type": "textarea"
        },
        {
          "path": "booking.times",
          "label": "Time slots (one per line)",
          "type": "textarea"
        },
        {
          "path": "booking.closedDays",
          "label": "Closed days (0 = Sunday … 6 = Saturday, comma separated)",
          "type": "text"
        },
        {
          "path": "booking.days",
          "label": "Days ahead to offer",
          "type": "number",
          "min": 3,
          "max": 30,
          "step": 1
        },
        {
          "path": "booking.formAction",
          "label": "Form address (optional)",
          "type": "url",
          "hint": "An https form endpoint such as Formspree. Empty: the form only shows the thank-you message."
        },
        {
          "path": "booking.done",
          "label": "Thank-you message",
          "type": "textarea",
          "hint": "{person} is their first name, {when} the day and time."
        }
      ]
    },
    {
      "group": "Footer",
      "fields": [
        {
          "path": "footer.text",
          "label": "Line",
          "type": "text"
        },
        {
          "path": "footer.legal",
          "label": "Small print",
          "type": "text"
        }
      ]
    },
    {
      "group": "Colours",
      "fields": [
        {
          "path": "theme.colors.page",
          "label": "Page",
          "type": "color"
        },
        {
          "path": "theme.colors.surface",
          "label": "Cards",
          "type": "color"
        },
        {
          "path": "theme.colors.text",
          "label": "Text",
          "type": "color"
        },
        {
          "path": "theme.colors.muted",
          "label": "Soft text",
          "type": "color"
        },
        {
          "path": "theme.colors.accent",
          "label": "Accent",
          "type": "color"
        },
        {
          "path": "theme.colors.accentSoft",
          "label": "Accent tint",
          "type": "color"
        },
        {
          "path": "theme.colors.highlight",
          "label": "Highlight (stars, badges)",
          "type": "color"
        },
        {
          "path": "theme.colors.dark",
          "label": "Dark panels",
          "type": "color"
        },
        {
          "path": "theme.colors.onAccent",
          "label": "Text on accent",
          "type": "color"
        }
      ]
    },
    {
      "group": "Fonts",
      "fields": [
        {
          "path": "theme.fonts.display",
          "label": "Headings font",
          "type": "font"
        },
        {
          "path": "theme.fonts.body",
          "label": "Body font",
          "type": "font"
        }
      ]
    },
    {
      "group": "Look and motion",
      "fields": [
        {
          "path": "theme.radius",
          "label": "Corner roundness",
          "type": "number",
          "min": 0,
          "max": 48,
          "step": 2
        },
        {
          "path": "motion.animate",
          "label": "Animations on",
          "type": "toggle"
        },
        {
          "path": "motion.heroScroll",
          "label": "Opening picture opens as you scroll",
          "type": "toggle"
        },
        {
          "path": "motion.floatBadges",
          "label": "Badges float",
          "type": "toggle"
        },
        {
          "path": "motion.reviewSeconds",
          "label": "Seconds per review",
          "type": "number",
          "min": 2,
          "max": 15,
          "step": 1
        }
      ]
    },
    {
      "group": "Library blocks",
      "fields": [
        {
          "path": "extras",
          "label": "Blocks from the library",
          "type": "blocks",
          "hint": "Add any section, effect or scene from the shared library below this template's own sections."
        }
      ]
    }
  ]
}
