{
  "id": "mossline",
  "name": "Mossline",
  "pitch": "A climate-data company told around one stand of pines: it lifts out of a misty valley, then turns while the live plot readings, the sensor network, the field station's five proofs, the three solutions and the contact come to it.",
  "kind": "static",
  "categories": [
    "Cinematic",
    "Scroll",
    "3D",
    "Climate"
  ],
  "business": [
    "product",
    "consulting",
    "nonprofit"
  ],
  "sector": "Climate tech and environmental data (carbon and biodiversity measurement)",
  "intensity": 6,
  "heavy": true,
  "licence": {
    "kind": "owner",
    "holder": "Mughees",
    "note": "Supplied by its owner as a whole project for use as a builder template. Rebuilt on the shared film engine (docs/FILM-TEMPLATES.md) around a licensed 3D model from the builder's asset library (trees-forest-001, CC0 Kenney); the owner's words and pictures are kept in source/media.",
    "added": "2026-11-18"
  },
  "remoteAssets": [],
  "features": [
    "One stand of pines at the centre of the whole page",
    "Lifts out of the valley as the page opens",
    "Live plot readings beside the figure",
    "Network numbers that count up",
    "Five proofs and three solutions with the owner's pictures",
    "Email contact"
  ],
  "roles": {
    "mode": "light",
    "stage": "light",
    "colors": {
      "ink": "ink",
      "ink2": "ink2",
      "mist": "page",
      "paper": "surface",
      "accent": "fill",
      "accent2": "fill2",
      "positive": "accentDeep",
      "deep": "dark"
    },
    "fonts": {
      "sans": "body",
      "mono": "keep"
    },
    "radius": "radius"
  },
  "schema": [
    {
      "group": "Business",
      "fields": [
        {
          "path": "brand.name",
          "label": "Name",
          "type": "text"
        },
        {
          "path": "seo.title",
          "label": "Page title",
          "type": "text"
        },
        {
          "path": "seo.description",
          "label": "Page description",
          "type": "textarea"
        }
      ]
    },
    {
      "group": "Menu",
      "fields": [
        {
          "path": "nav.links",
          "label": "Links (they scroll to the scene of that name)",
          "type": "list",
          "min": 0,
          "max": 6,
          "itemLabel": "label",
          "fields": [
            {
              "path": "label",
              "label": "Label",
              "type": "text"
            },
            {
              "path": "href",
              "label": "Goes to",
              "type": "text"
            }
          ]
        },
        {
          "path": "nav.cta",
          "label": "Button",
          "type": "text"
        },
        {
          "path": "nav.ctaHref",
          "label": "Button goes to",
          "type": "text"
        }
      ]
    },
    {
      "group": "Footer",
      "fields": [
        {
          "path": "footer.note",
          "label": "Small print",
          "type": "text"
        },
        {
          "path": "footer.email",
          "label": "Email",
          "type": "text"
        }
      ]
    },
    {
      "group": "Colours",
      "fields": [
        {
          "path": "theme.colors.ink",
          "label": "Text",
          "type": "color"
        },
        {
          "path": "theme.colors.ink2",
          "label": "Quiet text",
          "type": "color"
        },
        {
          "path": "theme.colors.mist",
          "label": "Page",
          "type": "color"
        },
        {
          "path": "theme.colors.paper",
          "label": "Cards",
          "type": "color"
        },
        {
          "path": "theme.colors.accent",
          "label": "Accent",
          "type": "color"
        },
        {
          "path": "theme.colors.accent2",
          "label": "Second accent",
          "type": "color"
        },
        {
          "path": "theme.colors.positive",
          "label": "Good news",
          "type": "color"
        },
        {
          "path": "theme.colors.deep",
          "label": "Deep",
          "type": "color"
        }
      ]
    },
    {
      "group": "Fonts and shape",
      "fields": [
        {
          "path": "theme.fonts.sans",
          "label": "Body font",
          "type": "font"
        },
        {
          "path": "theme.fonts.mono",
          "label": "Small print font",
          "type": "font"
        },
        {
          "path": "theme.radius",
          "label": "Corner roundness",
          "type": "number",
          "min": 0,
          "max": 40,
          "step": 1
        }
      ]
    },
    {
      "group": "Library sections",
      "fields": [
        {
          "path": "extras",
          "label": "Sections from the library (added after the story)",
          "type": "blocks"
        }
      ]
    }
  ]
}
