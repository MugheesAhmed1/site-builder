{
  "id": "cornerstone",
  "name": "Cornerstone",
  "pitch": "An estate agent told around one house: it rushes in from far away and then turns slowly, a new side to each scene, while the sold-in-weeks numbers, the homes, the monthly cost, the areas, the selling steps, the agents and the office come to it.",
  "kind": "static",
  "categories": [
    "Cinematic",
    "Scroll",
    "3D",
    "Editorial"
  ],
  "business": [
    "property",
    "consulting",
    "law"
  ],
  "sector": "Estate agent, property developer or lettings agency",
  "intensity": 6,
  "heavy": true,
  "licence": {
    "kind": "original",
    "holder": "Site Builder",
    "note": "Made for the builder as an original template. The story is told around a licensed 3D model from the builder's asset library (building-house-001, CC0 Kenney) by the shared film engine (docs/FILM-TEMPLATES.md). Pictures are free AI generations (Pollinations) kept in source/media.",
    "added": "2026-11-18"
  },
  "remoteAssets": [],
  "features": [
    "One house at the centre of the whole page",
    "It turns a quarter more with every scene",
    "Rushes in from far away",
    "Homes with prices, a monthly cost and the areas you can buy in",
    "Selling steps and your agents",
    "Office hours and a free valuation"
