{
  "id": "stride",
  "name": "Stride",
  "pitch": "A snack brand told around one piece of fruit: it drops in, then rises as you scroll while the five flavours, the colour picker (tap a flavour to repaint it), what is inside every bar, the nutrition, the packs and the first-dibs list come to it.",
  "kind": "static",
  "categories": [
    "Cinematic",
    "Scroll",
    "3D",
    "Food"
  ],
  "business": [
    "shop",
    "food",
    "product"
  ],
  "sector": "Food and drink brand selling online (plant protein snack bars)",
  "intensity": 7,
  "heavy": true,
  "licence": {
    "kind": "owner",
    "holder": "Mughees",
    "note": "Supplied by its owner as a whole project for use as a builder template. Rebuilt on the shared film engine (docs/FILM-TEMPLATES.md) around a licensed 3D model from the builder's asset library (food-avocado-001, CC0 Microsoft); the owner's words are kept.",
    "added": "2026-11-18"
  },
  "remoteAssets": [],
  "features": [
    "One avocado at the centre of the whole page",
    "Drops in with a ripple, then rises as you scroll",
    "Five flavour cards and a tap-to-repaint flavour picker",
    "What is inside every bar, and the nutrition in big numbers",
    "Three packs and a first-dibs list",
    "Confetti, heavy capitals and chunky corners"
  ],
  "roles": {
    "mode": "light",
    "stage": "light",
    "colors": {
      "ink": "ink",
      "cream": "light",
      "dark": "dark",
      "accent": "accent"
    },
    "fonts": {
      "display": "display",
      "body": "body",
      "mono": "keep"
    }
  },
  "schema": [
    {
      "group": "Business",
      "fields": [
        {
          "path": "brand.name",
          "label": "Name",
          "type": "text"
        },
        {
          "path": "seo.title",
          "label": "Page title",
          "type": "text"
        },
        {
          "path": "seo.description",
          "label": "Page description",
          "type": "textarea"
        }
      ]
    },
    {
      "group": "Menu",
      "fields": [
        {
          "path": "nav.links",
          "label": "Links (they scroll to the scene of that name)",
          "type": "list",
          "min": 0,
          "max": 6,
          "itemLabel": "label",
          "fields": [
            {
              "path": "label",
              "label": "Label",
              "type": "text"
            },
            {
