        },
        {
          "path": "nav.cta",
          "label": "Button",
          "type": "text"
        },
        {
          "path": "nav.ctaHref",
          "label": "Button goes to",
          "type": "text"
        }
      ]
    },
    {
      "group": "Footer",
      "fields": [
        {
          "path": "footer.note",
          "label": "Small print",
          "type": "text"
        },
        {
          "path": "footer.email",
          "label": "Email",
          "type": "text"
        }
      ]
    },
    {
      "group": "Colours",
      "fields": [
        {
          "path": "theme.colors.ink",
