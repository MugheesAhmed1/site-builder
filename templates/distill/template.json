{
  "id": "distill",
  "name": "Distill",
  "pitch": "A SaaS launch page with one striking idea: a draggable belt of sample web pages slides through a glowing scanner and dissolves into clean code, with a live counter of what was saved. Menus, pricing, demo, trial and sign-in panels included.",
  "kind": "vite",
  "categories": [
    "Interactive",
    "Product",
    "Experimental"
  ],
  "business": [
    "product",
    "consulting",
    "agency"
  ],
  "sector": "AI and web infrastructure SaaS (edge service that serves clean pages to AI agents)",
  "intensity": 6,
  "heavy": false,
  "licence": {
    "kind": "owner",
    "holder": "Mughees",
    "note": "Supplied by its owner as a whole project for use as a builder template.",
    "added": "2026-11-18"
  },
  "remoteAssets": [],
  "features": [
    "Draggable before-and-after belt",
    "Particle scanner",
    "Live savings counter",
    "Dropdown menus",
    "Pricing, demo, trial and sign-in panels"
  ],
  "roles": {
    "mode": "light",
    "stage": "light",
    "colors": {
      "bg": "page",
      "ink": "ink",
      "body": "ink2",
      "muted": "muted",
      "code": "muted",
      "comment": "faint",
      "hot": "accent",
      "hotSoft": "soft",
      "hotDeep": "accentDeep",
      "buttonText": "onAccent"
    },
    "fonts": {
      "sans": "body",
      "serif": "display",
      "mono": "keep"
    }
  },
  "schema": [
    {
      "group": "Business",
      "fields": [
        {
          "path": "brand.name",
          "label": "Product name",
          "type": "text",
          "hint": "Fills every {name} in the text below."
        },
        {
          "path": "seo.title",
          "label": "Page title (search and browser tab)",
          "type": "text"
        },
        {
          "path": "seo.description",
          "label": "Short description (search and sharing)",
          "type": "textarea"
        },
        {
          "path": "brand.showMark",
          "label": "Show the drop logo",
          "type": "toggle"
        }
      ]
    },
    {
      "group": "Menu",
      "fields": [
        {
          "path": "nav.menus",
          "label": "Dropdown menus",
          "type": "list",
          "itemLabel": "Menu",
          "fields": [
            {
              "path": "label",
              "label": "Label",
              "type": "text"
            },
            {
              "path": "items",
              "label": "Items (one per line: title | description)",
              "type": "textarea"
            }
          ],
          "min": 0,
          "max": 5
        },
        {
          "path": "nav.pricing",
          "label": "Pricing link (empty hides it)",
          "type": "text"
        },
        {
          "path": "nav.signin",
          "label": "Sign-in button (empty hides it)",
          "type": "text"
        },
        {
          "path": "nav.trial",
          "label": "Trial button (empty hides it)",
          "type": "text"
        },
        {
          "path": "nav.demo",
          "label": "Demo button (empty hides it)",
          "type": "text"
        }
      ]
    },
    {
      "group": "Opening",
      "fields": [
        {
          "path": "hero.eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "path": "hero.line1",
          "label": "Headline",
          "type": "text"
        },
        {
          "path": "hero.line2",
          "label": "Headline, second line (italic)",
          "type": "text"
        },
        {
          "path": "hero.text",
          "label": "Text",
          "type": "textarea"
        },
        {
          "path": "hero.button",
          "label": "Button",
          "type": "text"
        }
      ]
    },
    {
      "group": "Counter",
      "fields": [
        {
          "path": "badge.label",
          "label": "Label",
          "type": "text"
        },
        {
          "path": "badge.less",
          "label": "After the percentage",
          "type": "text"
        }
      ]
    },
    {
      "group": "Belt of sample pages",
      "fields": [
        {
          "path": "belt.site",
          "label": "Sample site name",
          "type": "text",
          "hint": "Shown on every card; {site} in the card text becomes it."
        },
        {
          "path": "belt.label",
          "label": "Description (for screen readers)",
          "type": "text"
        },
        {
          "path": "belt.cards",
          "label": "Cards",
          "type": "list",
          "itemLabel": "Card",
          "fields": [
            {
              "path": "layout",
              "label": "Layout",
              "type": "select",
              "options": [
                {
                  "value": "home",
                  "label": "Home: picture with big numbers"
                },
                {
                  "value": "price",
                  "label": "Price: warm gradient with a price list"
                },
                {
                  "value": "case",
                  "label": "Story: blurred picture, headline and three numbers"
                },
                {
                  "value": "vision",
                  "label": "Vision: two pictures and a quote"
                },
                {
                  "value": "alloy",
                  "label": "Product: picture, headline and specs"
                },
                {
                  "value": "journal",
                  "label": "Journal: three article cards"
                }
              ]
            },
            {
              "path": "menu",
              "label": "Card menu (comma separated)",
              "type": "text"
            },
            {
              "path": "active",
              "label": "Highlighted menu item",
              "type": "text"
            },
            {
              "path": "kicker",
              "label": "Small label",
              "type": "text"
            },
            {
              "path": "title",
              "label": "Headline (a price like $2,400 in the price layout)",
              "type": "textarea"
            },
            {
              "path": "emphasis",
              "label": "Italic words after it (vision and product)",
              "type": "text"
            },
            {
              "path": "text",
              "label": "Small text (vision)",
              "type": "textarea"
            },
            {
              "path": "rows",
              "label": "Rows (one per line: left | right)",
              "type": "textarea",
              "hint": "Numbers and labels, prices, specs or article label | title, depending on the layout."
            },
            {
              "path": "button",
              "label": "Button (price layout)",
              "type": "text"
            },
            {
              "path": "image",
              "label": "Picture",
              "type": "image"
            },
            {
              "path": "image2",
              "label": "Second picture (vision, journal)",
              "type": "image"
            },
            {
              "path": "image3",
              "label": "Third picture (journal)",
              "type": "image"
            },
            {
              "path": "address",
              "label": "Page address shown in the code",
              "type": "text"
            },
            {
              "path": "original",
              "label": "Size before (tokens)",
              "type": "number",
              "min": 0,
              "max": 1000000,
              "step": 1
            },
            {
              "path": "distilled",
              "label": "Size after (tokens)",
              "type": "number",
              "min": 0,
              "max": 1000000,
              "step": 1
            },
            {
              "path": "html",
              "label": "Clean code shown after the scanner",
              "type": "textarea"
            }
          ],
          "min": 1,
          "max": 10
        }
      ]
    },
    {
      "group": "Pricing panel",
      "fields": [
        {
          "path": "pricing.eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "path": "pricing.title",
          "label": "Title",
          "type": "text"
        },
        {
          "path": "pricing.tiers",
          "label": "Plans (one per line: name | price | detail)",
          "type": "textarea"
        },
        {
          "path": "pricing.button",
          "label": "Button",
          "type": "text"
        }
      ]
    },
    {
      "group": "How it works panel",
      "fields": [
        {
          "path": "explore.eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "path": "explore.title",
          "label": "Title",
          "type": "text"
        },
        {
          "path": "explore.text",
          "label": "Text",
          "type": "textarea"
        },
        {
          "path": "explore.facts",
          "label": "Facts (one per line)",
          "type": "textarea"
        },
        {
          "path": "explore.button",
          "label": "Button",
          "type": "text"
        }
      ]
    },
    {
      "group": "Demo, trial and sign-in forms",
      "fields": [
        {
          "path": "forms.demoEyebrow",
          "label": "Demo label",
          "type": "text"
        },
        {
          "path": "forms.demoTitle",
          "label": "Demo title",
          "type": "text"
        },
        {
          "path": "forms.demoButton",
          "label": "Demo button",
          "type": "text"
        },
        {
          "path": "forms.trialEyebrow",
          "label": "Trial label",
          "type": "text"
        },
        {
          "path": "forms.trialTitle",
          "label": "Trial title",
          "type": "text"
        },
        {
          "path": "forms.trialButton",
          "label": "Trial button",
          "type": "text"
        },
        {
          "path": "forms.signinEyebrow",
          "label": "Sign-in label",
          "type": "text"
        },
        {
          "path": "forms.signinTitle",
          "label": "Sign-in title",
          "type": "text"
        },
        {
          "path": "forms.signinButton",
          "label": "Sign-in button",
          "type": "text"
        },
        {
          "path": "forms.signinLink",
          "label": "Sign-in page (optional)",
          "type": "url",
          "hint": "When set, signing in goes to your real app."
        },
        {
          "path": "forms.emailLabel",
          "label": "Email label",
          "type": "text"
        },
        {
          "path": "forms.emailPlaceholder",
          "label": "Email hint",
          "type": "text"
        },
        {
          "path": "forms.domainLabel",
          "label": "Domain label",
          "type": "text"
        },
        {
          "path": "forms.domainPlaceholder",
          "label": "Domain hint",
          "type": "text"
        },
        {
          "path": "forms.thanksTitle",
          "label": "Thank-you title",
          "type": "text"
        },
        {
          "path": "forms.thanksText",
          "label": "Thank-you text",
          "type": "textarea",
          "hint": "{email} and {domain} are filled in."
        },
        {
          "path": "forms.domainFallback",
          "label": "When no domain is given",
          "type": "text"
        },
        {
          "path": "forms.signinThanksTitle",
          "label": "Sign-in thank-you title",
          "type": "text"
        },
        {
          "path": "forms.signinThanksText",
          "label": "Sign-in thank-you text",
          "type": "textarea"
        },
        {
          "path": "forms.back",
          "label": "Close button",
          "type": "text"
        },
        {
          "path": "forms.error",
          "label": "Error message",
          "type": "text"
        },
        {
          "path": "forms.email",
          "label": "Send requests to (email)",
          "type": "text",
          "hint": "Opens the visitor's email app with the request filled in."
        },
        {
          "path": "forms.formAction",
          "label": "Or post to a form service (https)",
          "type": "url",
          "hint": "For example a Formspree or Basin endpoint. Wins over email."
        }
      ]
    },
    {
      "group": "Colours",
      "fields": [
        {
          "path": "theme.colors.bg",
          "label": "Page",
          "type": "color"
        },
        {
          "path": "theme.colors.ink",
          "label": "Headings",
          "type": "color"
        },
        {
          "path": "theme.colors.body",
          "label": "Text",
          "type": "color"
        },
        {
          "path": "theme.colors.muted",
          "label": "Quiet text",
          "type": "color"
        },
        {
          "path": "theme.colors.code",
          "label": "Code",
          "type": "color"
        },
        {
          "path": "theme.colors.comment",
          "label": "Code comments",
          "type": "color"
        },
        {
          "path": "theme.colors.hot",
          "label": "Scanner and buttons",
          "type": "color"
        },
        {
          "path": "theme.colors.hotSoft",
          "label": "Scanner, soft",
          "type": "color"
        },
        {
          "path": "theme.colors.hotDeep",
          "label": "Scanner, deep",
          "type": "color"
        },
        {
          "path": "theme.colors.buttonText",
          "label": "Button text",
          "type": "color"
        }
      ]
    },
    {
      "group": "Fonts",
      "fields": [
        {
          "path": "theme.fonts.sans",
          "label": "Text",
          "type": "font"
        },
        {
          "path": "theme.fonts.serif",
          "label": "Headlines",
          "type": "font"
        },
        {
          "path": "theme.fonts.mono",
          "label": "Code",
          "type": "font"
        }
      ]
    },
    {
      "group": "Motion",
      "fields": [
        {
          "path": "motion.speed",
          "label": "Belt speed",
          "type": "number",
          "min": 0,
          "max": 0.3,
          "step": 0.005
        },
        {
          "path": "motion.hoverSlow",
          "label": "Slow down on hover",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "path": "motion.particles",
          "label": "Dissolving particles",
          "type": "toggle"
        },
        {
          "path": "motion.sparks",
          "label": "Sparks",
          "type": "toggle"
        }
      ]
    },
    {
      "group": "Library blocks",
      "fields": [
        {
          "path": "extras",
          "label": "Blocks from the library",
          "type": "blocks",
          "hint": "Add any section, effect or scene from the shared library below this template's own sections."
        }
      ]
    }
  ]
}
