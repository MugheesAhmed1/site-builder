{
  "id": "distill",
  "name": "Distill",
  "pitch": "A SaaS launch page told around one machine reader: it spins into place, then shows its front and its back as the numbers, how it works, a belt of pages that shrink, the product, the prices and the way to start come to it, with sparks in the air.",
  "kind": "static",
  "categories": [
    "Cinematic",
    "Product",
    "3D",
    "Experimental"
  ],
  "business": [
    "product",
    "consulting",
    "agency"
  ],
  "sector": "AI and web infrastructure SaaS (edge service that serves clean pages to AI agents)",
  "intensity": 7,
  "heavy": true,
  "licence": {
    "kind": "owner",
    "holder": "Mughees",
    "note": "Supplied by its owner as a whole project for use as a builder template. Rebuilt on the shared film engine (docs/FILM-TEMPLATES.md) around a licensed 3D model from the builder's asset library (character-robot-001, CC0 Quaternius); the owner's words and pictures are kept in source/media.",
    "added": "2026-11-18"
  },
  "remoteAssets": [],
  "features": [
    "One robot reader at the centre of the whole page",
    "Front, back, front: the camera flips from scene to scene",
    "Sparks in the air",
    "How it works, the pages it shrinks and the token savings",
    "Pricing tiers",
    "Start a free trial or book a demo"
  ],
  "roles": {
    "mode": "light",
    "stage": "light",
    "colors": {
      "bg": "page",
      "ink": "ink",
      "body": "ink2",
