          "type": "color"
        },
        {
          "path": "theme.colors.lightText",
          "label": "Services text",
          "type": "color"
        },
        {
          "path": "theme.colors.headingFrom",
          "label": "Headline gradient, top",
          "type": "color"
        },
        {
          "path": "theme.colors.headingTo",
          "label": "Headline gradient, bottom",
          "type": "color"
        },
        {
          "path": "theme.colors.grad1",
          "label": "Button gradient 1",
          "type": "color"
        },
        {
          "path": "theme.colors.grad2",
          "label": "Button gradient 2",
          "type": "color"
        },
        {
          "path": "theme.colors.grad3",
          "label": "Button gradient 3",
          "type": "color"
        },
        {
          "path": "theme.colors.grad4",
          "label": "Button gradient 4",
          "type": "color"
        },
        {
          "path": "theme.colors.buttonText",
          "label": "Button text",
          "type": "color"
        }
      ]
    },
    {
      "group": "Font",
      "fields": [
        {
          "path": "theme.fonts.display",
          "label": "Font",
          "type": "font"
        }
      ]
    },
    {
      "group": "Motion",
      "fields": [
        {
          "path": "motion.animate",
          "label": "Animations on",
          "type": "toggle"
        },
        {
          "path": "motion.marqueeSpeed",
          "label": "Reel speed",
          "type": "number",
          "min": 0,
          "max": 1.5,
          "step": 0.05
        },
        {
          "path": "motion.magnet",
          "label": "Portrait pull (0 is off)",
          "type": "number",
          "min": 0,
          "max": 5,
          "step": 0.5
        },
        {
          "path": "motion.cardStack",
          "label": "Project cards shrink as they stack",
          "type": "toggle"
        }
      ]
    },
    {
      "group": "Library blocks",
      "fields": [
        {
          "path": "extras",
          "label": "Blocks from the library",
          "type": "blocks",
          "hint": "Add any section, effect or scene from the shared library below this template's own sections."
        }
      ]
    }
  ]
