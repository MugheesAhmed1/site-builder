  "schema": [
    {
      "group": "Business",
      "fields": [
        {
          "path": "brand.name",
          "label": "Your name",
          "type": "text",
          "hint": "Fills every {name} in the text below."
        },
        {
          "path": "seo.title",
          "label": "Page title (search and browser tab)",
          "type": "text"
        },
        {
          "path": "seo.description",
          "label": "Short description (search and sharing)",
          "type": "textarea"
        }
      ]
    },
    {
      "group": "Sections",
      "fields": [
        {
          "path": "sections.marquee",
          "label": "Image reels",
          "type": "toggle"
        },
        {
          "path": "sections.about",
          "label": "About",
          "type": "toggle"
        },
        {
          "path": "sections.services",
          "label": "Services",
          "type": "toggle"
        },
        {
          "path": "sections.projects",
          "label": "Projects",
          "type": "toggle"
        }
      ]
    },
    {
      "group": "Menu",
      "fields": [
        {
          "path": "nav.about",
          "label": "About link",
          "type": "text"
        },
        {
          "path": "nav.services",
          "label": "Services link",
          "type": "text"
        },
        {
          "path": "nav.projects",
          "label": "Projects link",
          "type": "text"
        },
        {
          "path": "nav.contact",
          "label": "Contact link",
          "type": "text"
        }
      ]
    },
    {
      "group": "Opening",
      "fields": [
        {
          "path": "hero.title",
          "label": "Headline",
          "type": "text"
        },
        {
          "path": "hero.tagline",
          "label": "Line under it",
          "type": "textarea"
        },
        {
          "path": "hero.portrait",
          "label": "Portrait",
          "type": "image"
        },
        {
          "path": "hero.portraitAlt",
          "label": "Portrait description",
          "type": "text"
        },
        {
          "path": "hero.blend",
          "label": "Fade the portrait's edges into the page",
          "type": "toggle"
        }
      ]
    },
    {
      "group": "Buttons",
      "fields": [
        {
          "path": "buttons.contact",
          "label": "Contact button",
          "type": "text"
        },
        {
          "path": "buttons.project",
          "label": "Project button",
          "type": "text"
        },
        {
          "path": "buttons.visit",
          "label": "Project link button",
          "type": "text"
        }
      ]
    },
    {
      "group": "Image reels",
      "fields": [
        {
          "path": "marquee.label",
          "label": "Description (for screen readers)",
          "type": "text"
        },
        {
          "path": "marquee.row1",
          "label": "Top row",
          "type": "list",
          "itemLabel": "Picture",
          "fields": [
            {
              "path": "image",
              "label": "Picture",
              "type": "image"
            }
          ],
          "min": 0,
          "max": 16
        },
        {
          "path": "marquee.row2",
          "label": "Bottom row",
          "type": "list",
          "itemLabel": "Picture",
          "fields": [
            {
              "path": "image",
              "label": "Picture",
              "type": "image"
            }
          ],
          "min": 0,
          "max": 16
        }
      ]
    },
    {
      "group": "About",
      "fields": [
        {
          "path": "about.title",
          "label": "Title",
          "type": "text"
        },
        {
          "path": "about.text",
          "label": "Text (lights up word by word)",
          "type": "textarea"
        },
        {
          "path": "about.decor1",
          "label": "Picture, top left",
          "type": "image"
        },
        {
          "path": "about.decor2",
          "label": "Picture, bottom left",
          "type": "image"
        },
        {
          "path": "about.decor3",
          "label": "Picture, top right",
          "type": "image"
        },
        {
          "path": "about.decor4",
          "label": "Picture, bottom right",
          "type": "image"
        },
        {
          "path": "about.blend",
          "label": "Fade the pictures' edges into the page",
          "type": "toggle"
        }
      ]
    },
    {
      "group": "Services",
      "fields": [
        {
          "path": "services.title",
          "label": "Title",
          "type": "text"
        },
        {
          "path": "services.items",
          "label": "Services",
          "type": "list",
          "itemLabel": "Service",
          "fields": [
            {
              "path": "number",
              "label": "Number",
              "type": "text"
            },
            {
              "path": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "path": "description",
              "label": "Description",
              "type": "textarea"
            }
          ],
          "min": 0,
          "max": 12
        }
      ]
    },
    {
      "group": "Projects",
      "fields": [
        {
          "path": "projects.title",
          "label": "Title",
          "type": "text"
        },
        {
          "path": "projects.items",
          "label": "Projects",
          "type": "list",
          "itemLabel": "Project",
          "fields": [
            {
              "path": "number",
              "label": "Number",
              "type": "text"
            },
            {
              "path": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "path": "category",
              "label": "Category",
              "type": "text"
            },
            {
              "path": "year",
              "label": "Year",
              "type": "text"
            },
            {
              "path": "summary",
              "label": "Summary",
              "type": "textarea"
            },
            {
              "path": "deliverables",
              "label": "Deliverables (comma or one per line)",
              "type": "textarea"
            },
            {
              "path": "image1",
              "label": "Small picture 1",
              "type": "image"
            },
            {
              "path": "image2",
              "label": "Small picture 2",
              "type": "image"
            },
            {
              "path": "image3",
              "label": "Main picture",
              "type": "image"
            },
            {
              "path": "link",
              "label": "Link (optional)",
              "type": "url"
            }
          ],
          "min": 0,
          "max": 12
        }
      ]
    },
    {
      "group": "Contact form",
      "fields": [
        {
          "path": "contact.kicker",
          "label": "Label",
          "type": "text"
        },
        {
          "path": "contact.title",
          "label": "Title",
          "type": "text"
        },
        {
          "path": "contact.nameLabel",
          "label": "Name label",
          "type": "text"
        },
        {
          "path": "contact.namePlaceholder",
          "label": "Name hint",
          "type": "text"
        },
        {
          "path": "contact.emailLabel",
          "label": "Email label",
          "type": "text"
        },
        {
          "path": "contact.emailPlaceholder",
          "label": "Email hint",
          "type": "text"
        },
        {
          "path": "contact.serviceLabel",
          "label": "Service label",
          "type": "text",
          "hint": "The choices are your services."
        },
        {
          "path": "contact.briefLabel",
          "label": "Message label",
          "type": "text"
        },
        {
          "path": "contact.briefPlaceholder",
          "label": "Message hint",
          "type": "textarea"
        },
        {
          "path": "contact.prefill",
          "label": "Message started from a project",
          "type": "textarea",
          "hint": "{project} becomes the project's name."
        },
        {
          "path": "contact.button",
          "label": "Send button",
          "type": "text"
        },
        {
          "path": "contact.thanksTitle",
          "label": "Thank-you title",
          "type": "text"
        },
        {
          "path": "contact.thanksText",
          "label": "Thank-you text",
          "type": "textarea",
          "hint": "{visitor}, {service} and {email} are filled in."
        },
        {
          "path": "contact.done",
          "label": "Close button",
          "type": "text"
        },
        {
          "path": "contact.error",
          "label": "Error message",
          "type": "text"
        },
        {
          "path": "contact.email",
          "label": "Send messages to (email)",
          "type": "text",
          "hint": "Opens the visitor's email app with the message filled in."
        },
        {
          "path": "contact.formAction",
          "label": "Or post to a form service (https)",
          "type": "url",
          "hint": "For example a Formspree or Basin endpoint. Wins over email."
        }
      ]
    },
    {
      "group": "Footer",
      "fields": [
        {
          "path": "footer",
          "label": "Footer line (optional)",
          "type": "text",
          "hint": "{year} becomes this year."
        }
      ]
    },
    {
      "group": "Colours",
      "fields": [
        {
          "path": "theme.colors.page",
          "label": "Page",
          "type": "color"
        },
        {
          "path": "theme.colors.text",
          "label": "Text",
          "type": "color"
        },
        {
          "path": "theme.colors.surface",
          "label": "Cards and inputs",
