{
  "id": "fernhollow",
  "name": "Fernhollow",
  "pitch": "A night studio told around one growing thing: it comes out of the dark and the camera climbs as you scroll, fireflies drifting past, while the studio's story, its work, its journal and the way to start a conversation arrive around it.",
  "kind": "static",
  "categories": [
    "3D",
    "Cinematic",
    "Scroll",
    "Editorial"
  ],
  "business": [
    "agency",
    "photo",
    "consulting"
  ],
  "sector": "Creative and design studio (portfolio, journal and enquiries)",
  "intensity": 7,
  "heavy": true,
  "licence": {
    "kind": "owner",
    "holder": "Mughees",
    "note": "Supplied by its owner as a whole project for use as a builder template. Rebuilt on the shared film engine (docs/FILM-TEMPLATES.md) around a licensed 3D model from the builder's asset library (bush-001, CC0 KayKit); the owner's words and pictures are kept in source/media.",
    "added": "2026-11-18"
  },
  "remoteAssets": [],
  "features": [
    "One sprout at the centre of the whole page",
    "It comes out of the dark",
    "Fireflies in the air",
    "The camera climbs as you scroll",
    "About, work and journal told around it",
    "A way to start a conversation"
  ],
  "roles": {
    "mode": "dark",
    "stage": "dark",
    "colors": {
      "text": "ink",
      "buttonText": "page",
      "background": "page",
      "panel": "surface"
    },
    "fonts": {
      "display": "display",
      "body": "body"
    }
  },
  "schema": [
    {
      "group": "Business",
      "fields": [
        {
          "path": "brand.name",
          "label": "Name",
          "type": "text"
        },
        {
          "path": "seo.title",
          "label": "Page title",
          "type": "text"
        },
        {
          "path": "seo.description",
          "label": "Page description",
          "type": "textarea"
        }
      ]
    },
    {
      "group": "Menu",
      "fields": [
        {
          "path": "nav.links",
          "label": "Links (they scroll to the scene of that name)",
          "type": "list",
          "min": 0,
          "max": 6,
          "itemLabel": "label",
          "fields": [
            {
              "path": "label",
              "label": "Label",
              "type": "text"
            },
            {
              "path": "href",
              "label": "Goes to",
              "type": "text"
            }
          ]
        },
        {
          "path": "nav.cta",
          "label": "Button",
          "type": "text"
        },
        {
          "path": "nav.ctaHref",
          "label": "Button goes to",
          "type": "text"
        }
      ]
    },
    {
      "group": "Footer",
      "fields": [
        {
          "path": "footer.note",
          "label": "Small print",
          "type": "text"
        },
        {
          "path": "footer.email",
          "label": "Email",
          "type": "text"
        }
      ]
    },
    {
      "group": "Colours",
      "fields": [
        {
          "path": "theme.colors.text",
          "label": "Text",
          "type": "color"
        },
        {
          "path": "theme.colors.buttonText",
          "label": "Text on buttons",
          "type": "color"
        },
        {
          "path": "theme.colors.background",
          "label": "Page",
          "type": "color"
        },
        {
          "path": "theme.colors.panel",
          "label": "Cards",
          "type": "color"
        }
      ]
    },
    {
      "group": "Fonts and shape",
      "fields": [
        {
          "path": "theme.fonts.display",
          "label": "Headline font",
          "type": "font"
        },
        {
          "path": "theme.fonts.body",
          "label": "Body font",
          "type": "font"
        },
        {
          "path": "theme.radius",
          "label": "Corner roundness",
          "type": "number",
          "min": 0,
          "max": 40,
          "step": 1
        }
      ]
    },
    {
      "group": "Library sections",
      "fields": [
        {
          "path": "extras",
          "label": "Sections from the library (added after the story)",
          "type": "blocks"
        }
      ]
