{
  "id": "lithos",
  "name": "Lithos",
  "pitch": "A geology course told around one heap of rock: it rushes in from far away, then sinks layer by layer while the chapters, the field guides, the crust's six layers (tap one to repaint the rocks in its colour), the plans and the live tour come to it.",
  "kind": "static",
  "categories": [
    "Cinematic",
    "Scroll",
    "3D",
    "Education"
  ],
  "business": [
    "school",
    "product",
    "nonprofit"
  ],
  "sector": "Online course and field-guide platform (geology and earth science education)",
  "intensity": 7,
  "heavy": true,
  "licence": {
    "kind": "owner",
    "holder": "Mughees",
    "note": "Supplied by its owner as a whole project for use as a builder template. Rebuilt on the shared film engine (docs/FILM-TEMPLATES.md) around a licensed 3D model from the builder's asset library (rocks-001, CC0 KayKit); the owner's words and pictures are kept in source/media.",
    "added": "2026-11-18"
  },
  "remoteAssets": [],
  "features": [
    "One heap of rock at the centre of the whole page",
    "Rushes in, then sinks as you scroll",
    "Tap a layer to repaint the rocks",
    "Course chapters, field guides and the six layers of the crust",
    "Plans and a live tour",
    "Sign up"
  ],
  "roles": {
    "mode": "dark",
    "stage": "dark",
    "colors": {
      "accent": "accent",
      "accentHover": "accentDeep",
      "text": "ink",
      "page": "page",
      "panel": "surface",
      "button": "light",
      "buttonText": "onLight"
    },
    "fonts": {
      "display": "display",
      "body": "body"
    }
  },
  "schema": [
    {
      "group": "Business",
      "fields": [
        {
          "path": "brand.name",
          "label": "Name",
          "type": "text"
        },
        {
          "path": "seo.title",
          "label": "Page title",
          "type": "text"
        },
        {
          "path": "seo.description",
          "label": "Page description",
          "type": "textarea"
        }
      ]
    },
    {
      "group": "Menu",
      "fields": [
        {
          "path": "nav.links",
          "label": "Links (they scroll to the scene of that name)",
          "type": "list",
          "min": 0,
          "max": 6,
          "itemLabel": "label",
          "fields": [
            {
              "path": "label",
              "label": "Label",
              "type": "text"
            },
            {
              "path": "href",
              "label": "Goes to",
              "type": "text"
            }
          ]
        },
        {
          "path": "nav.cta",
          "label": "Button",
          "type": "text"
        },
        {
          "path": "nav.ctaHref",
          "label": "Button goes to",
          "type": "text"
        }
      ]
    },
    {
      "group": "Footer",
      "fields": [
        {
          "path": "footer.note",
          "label": "Small print",
          "type": "text"
        },
        {
          "path": "footer.email",
          "label": "Email",
          "type": "text"
        }
      ]
    },
    {
      "group": "Colours",
      "fields": [
        {
          "path": "theme.colors.accent",
          "label": "Accent",
          "type": "color"
        },
        {
          "path": "theme.colors.accentHover",
          "label": "Accent on hover",
          "type": "color"
        },
        {
          "path": "theme.colors.text",
          "label": "Text",
          "type": "color"
        },
        {
          "path": "theme.colors.page",
          "label": "Page",
          "type": "color"
        },
        {
          "path": "theme.colors.panel",
          "label": "Cards",
          "type": "color"
        },
        {
          "path": "theme.colors.button",
          "label": "Buttons",
          "type": "color"
        },
        {
          "path": "theme.colors.buttonText",
          "label": "Text on buttons",
          "type": "color"
        }
      ]
    },
    {
      "group": "Fonts and shape",
      "fields": [
        {
          "path": "theme.fonts.display",
          "label": "Headline font",
          "type": "font"
        },
        {
          "path": "theme.fonts.body",
          "label": "Body font",
          "type": "font"
        },
        {
          "path": "theme.radius",
          "label": "Corner roundness",
          "type": "number",
          "min": 0,
          "max": 40,
          "step": 1
        }
      ]
    },
    {
      "group": "Library sections",
      "fields": [
        {
          "path": "extras",
          "label": "Sections from the library (added after the story)",
          "type": "blocks"
        }
      ]
    }
  ]
}
