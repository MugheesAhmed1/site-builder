{
  "id": "orbit",
  "name": "Orbit",
  "pitch": "A studio site told around one small astronaut: it rushes in from deep space, then drifts as you scroll while what the studio does, who it is, a kind word and the contact come to it. The blank, character-first canvas: swap the character and the colours and words follow.",
  "kind": "static",
  "categories": [
    "Cinematic",
    "Scroll",
    "3D",
    "Studio"
  ],
  "business": [
    "general",
    "product",
    "agency",
    "creator",
    "shop",
    "school",
    "events"
  ],
  "sector": "Any business or person: the new template the journey builds around a character",
  "intensity": 6,
  "heavy": true,
  "licence": {
    "kind": "original",
    "holder": "Site Builder",
    "note": "Made for the builder as its blank, character-first canvas; rebuilt on the shared film engine (docs/FILM-TEMPLATES.md) around a licensed 3D model from the builder's asset library (character-astronaut-001, supplied by the project owner).",
    "added": "2026-11-22"
  },
  "remoteAssets": [],
  "features": [
    "One astronaut at the centre of the whole page",
    "Rushes in out of the stars, then drifts as you scroll",
    "Three things the studio does, around the figure",
    "About, a kind word and the contact",
    "Change the character and the whole page follows"
  ],
  "roles": {
    "mode": "dark",
    "modes": [
      "light",
      "dark"
    ],
    "stage": "dark",
    "colors": {
      "page": "page",
      "surface": "surface",
      "surface2": "surface2",
      "ink": "ink",
      "muted": "muted",
      "line": "line",
      "accent": "accent",
      "accent2": "accent2",
      "onAccent": "onAccent"
    },
    "fonts": {
      "display": "display",
      "body": "body"
    },
    "radius": "radius"
  },
  "schema": [
    {
