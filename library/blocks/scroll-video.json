{
  "name": "Scroll-driven film",
  "kind": "section",
  "from": "mossline",
  "description": "A film pinned to the screen that plays as the visitor scrolls, forwards and backwards, with captions taking turns.",
  "tags": ["video", "story", "scroll", "cinematic"],
  "business": ["product", "auto", "property", "hotel", "events", "food", "fitness"],
  "heavy": false,
  "fields": [
    { "path": "video", "label": "Film (short, mp4)", "type": "video", "hint": "Films with a keyframe every few frames scrub most smoothly." },
    { "path": "captions", "label": "Captions (one per line, in order)", "type": "textarea" },
    { "path": "length", "label": "Scroll length (screens)", "type": "number", "min": 1.5, "max": 8, "step": 0.5 },
    { "path": "shade", "label": "Darken the film", "type": "number", "min": 0, "max": 0.9, "step": 0.05 },
    { "path": "background", "label": "Background", "type": "color" },
    { "path": "text", "label": "Text colour", "type": "color" }
  ],
  "defaults": {
    "video": "",
    "captions": "It starts with an idea.\nThen it takes shape.\nAnd then it is yours.",
    "length": 3,
    "shade": 0.35,
    "background": "#000000",
    "text": "#ffffff"
  }
}
