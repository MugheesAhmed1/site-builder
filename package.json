{
  "name": "site-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/bundle-template.mjs && node scripts/build-site-kit.mjs && node scripts/build-templates.mjs && node scripts/build-library.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/bundle-template.mjs && node scripts/build-site-kit.mjs && node scripts/build-templates.mjs && node scripts/build-library.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "templates": "node scripts/build-templates.mjs && node scripts/build-library.mjs",
    "library": "node scripts/build-library.mjs",
    "import-template": "node scripts/import-template.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "jszip": "^3.10.2",
    "lenis": "1.1.13",
    "motion": "14.7.1",
    "next": "^15.5.27",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
